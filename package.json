{
  "name": "last-lantern",
  "productName": "آخرین چراغ",
  "version": "0.1.0",
  "description": "A wordless 2D platformer about a child, a fading lantern and an empty city.",
  "main": "electron/main.js",
  "scripts": {
    "serve": "python3 -m http.server 8123",
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.lastlantern.game",
    "productName": "Last Lantern",
    "files": ["index.html", "style.css", "src/**/*", "electron/**/*"],
    "mac": { "target": "dmg", "category": "public.app-category.games" },
    "win": { "target": "nsis" }
  }
}
